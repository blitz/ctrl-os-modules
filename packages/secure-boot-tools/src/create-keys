#!/usr/bin/env nix-shell
#!nix-shell -i bash -p openssl util-linux

# Create the keys of a custom Secure Boot CA:
#
# - PK signs updates of PK and KEK.
# - KEK signs updates of db and dbx.
# - The db CA certificate is enrolled in db. The db CA issues the certificates
#   that sign boot binaries, so signing keys can be replaced without updating
#   db.
#
# These keys belong on an offline machine. Run create-enrollment afterwards to
# build the signed signature lists to enroll.

set -euo pipefail

# Should be enough for any use case. Harvest and decrypt later is not a concern, because nothing is encrypted with this
# key. Once attacks become relevant, there systems can be migrated to stronger keys.
RSA_KEYLEN=2048

# Firmware does not check certificate expiry, because it has no trusted time
# source. The validity period only matters to tools such as sbverify and must
# cover all certificates issued by the db CA.
VALIDITY_DAYS=7300

# Private keys.
SECRETS_DIR=secrets
# Certificates and the owner GUID.
PUBLIC_DIR=public

if [[ -e $SECRETS_DIR ]]; then
    echo "$SECRETS_DIR already exists. Refusing to overwrite existing keys." >&2
    exit 1
fi

mkdir -m 700 "$SECRETS_DIR"
mkdir -p "$PUBLIC_DIR"

uuidgen > "$PUBLIC_DIR/GUID.txt"

# Create a private key and a self-signed certificate. Additional arguments are
# passed to openssl req.
create_key() {
    local name=$1 cn=$2
    shift 2

    openssl req -new -x509 -newkey "rsa:$RSA_KEYLEN" -subj "/CN=$cn/" \
        -keyout "$SECRETS_DIR/$name.key" -out "$PUBLIC_DIR/$name.crt" \
        -days "$VALIDITY_DAYS" -nodes -sha256 "$@"
}

create_key PK "Custom Secure Boot PK"
create_key KEK "Custom Secure Boot KEK"
create_key db-ca "Custom Secure Boot db CA" \
    -addext "basicConstraints=critical,CA:TRUE,pathlen:0" \
    -addext "keyUsage=critical,keyCertSign,cRLSign"
